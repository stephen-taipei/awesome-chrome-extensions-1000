{
  "manifest_version": 3,
  "name": "Highlight Export",
  "version": "1.0.0",
  "description": "Export highlights to text or markdown format",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Highlight Export"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
