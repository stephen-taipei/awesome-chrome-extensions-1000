{
  "manifest_version": 3,
  "name": "Progress Tracker",
  "version": "1.0.0",
  "description": "Track your learning progress across subjects",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Progress Tracker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
