{
  "manifest_version": 3,
  "name": "Focus Reader",
  "version": "1.0.0",
  "description": "Remove distractions while reading for better focus",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Reader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
