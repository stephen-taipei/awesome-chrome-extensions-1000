{
  "manifest_version": 3,
  "name": "Note Organizer",
  "version": "1.0.0",
  "description": "Organize study notes into folders and categories",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Note Organizer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
