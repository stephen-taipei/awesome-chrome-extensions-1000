{
  "manifest_version": 3,
  "name": "Reading Progress",
  "version": "1.0.0",
  "description": "Track reading progress across articles and books",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reading Progress"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
