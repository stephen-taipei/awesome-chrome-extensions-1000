{
  "manifest_version": 3,
  "name": "Flashcard Maker",
  "version": "1.0.0",
  "description": "Create flashcards from selected text for studying",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flashcard Maker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
