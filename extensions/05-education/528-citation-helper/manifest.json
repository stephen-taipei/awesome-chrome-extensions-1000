{
  "manifest_version": 3,
  "name": "Citation Helper",
  "version": "1.0.0",
  "description": "Format citations quickly in APA, MLA, and Chicago styles",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Citation Helper"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
