{
  "manifest_version": 3,
  "name": "Outline Maker",
  "version": "1.0.0",
  "description": "Create outlines from articles for better comprehension",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Outline Maker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
