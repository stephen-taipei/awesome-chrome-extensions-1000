{
  "manifest_version": 3,
  "name": "Summary Maker",
  "version": "1.0.0",
  "description": "Summarize selected text from web pages for quick review",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Summary Maker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
