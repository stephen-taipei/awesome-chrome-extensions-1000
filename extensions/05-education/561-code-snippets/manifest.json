{
  "manifest_version": 3,
  "name": "Code Snippets",
  "version": "1.0.0",
  "description": "Save and organize code snippets for quick reference",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Code Snippets"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
