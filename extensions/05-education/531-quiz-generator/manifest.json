{
  "manifest_version": 3,
  "name": "Quiz Generator",
  "version": "1.0.0",
  "description": "Generate quizzes from content for self-testing",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quiz Generator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
