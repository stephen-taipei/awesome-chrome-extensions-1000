{
  "manifest_version": 3,
  "name": "Review Scheduler",
  "version": "1.0.0",
  "description": "Spaced repetition scheduling for effective review",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Review Scheduler"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
