{
  "manifest_version": 3,
  "name": "Bookmark Annotator",
  "version": "1.0.0",
  "description": "Add annotations and notes to your bookmarks",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Annotator"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
