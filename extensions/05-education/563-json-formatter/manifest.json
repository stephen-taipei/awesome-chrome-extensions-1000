{
  "manifest_version": 3,
  "name": "JSON Formatter",
  "version": "1.0.0",
  "description": "Format, validate, and minify JSON data",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JSON Formatter"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
