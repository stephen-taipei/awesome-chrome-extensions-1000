{
  "manifest_version": 3,
  "name": "Note Taker",
  "version": "1.0.0",
  "description": "Quick study notes for capturing ideas while browsing",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Note Taker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
