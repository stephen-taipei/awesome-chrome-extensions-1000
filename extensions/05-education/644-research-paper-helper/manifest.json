{
  "manifest_version": 3,
  "name": "Research Paper Helper",
  "version": "1.0.0",
  "description": "A educational tool that helps you with research paper helper.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Research Paper Helper"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
