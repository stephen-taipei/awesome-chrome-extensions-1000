{
  "manifest_version": 3,
  "name": "Speed Reader",
  "version": "1.0.0",
  "description": "Speed reading trainer with RSVP technique",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Speed Reader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
