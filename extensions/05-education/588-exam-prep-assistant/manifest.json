{
  "manifest_version": 3,
  "name": "Exam Prep Assistant",
  "version": "1.0.0",
  "description": "A educational tool that helps you with exam prep assistant.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Exam Prep Assistant"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
