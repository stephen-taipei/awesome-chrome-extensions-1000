{
  "manifest_version": 3,
  "name": "Definition Finder",
  "version": "1.0.0",
  "description": "Highlight terms and save definitions for vocabulary building",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Definition Finder"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
