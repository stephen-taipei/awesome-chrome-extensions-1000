{
  "manifest_version": 3,
  "name": "Regex Tester",
  "version": "1.0.0",
  "description": "Test and validate regular expressions with real-time matching",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Regex Tester"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
