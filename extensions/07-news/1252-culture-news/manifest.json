{
  "manifest_version": 3,
  "name": "Culture News",
  "version": "1.0.0",
  "description": "A news and information tool that helps you with culture news.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Culture News"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
